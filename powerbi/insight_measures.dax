Analytics Ready =
SELECTEDVALUE(reporting_readiness[analytics_ready],FALSE())

Risk Ready =
SELECTEDVALUE(reporting_readiness[risk_ready],FALSE())

Insights Ready =
SELECTEDVALUE(reporting_readiness[insights_ready],FALSE())

Readiness =
IF(COUNTROWS(reporting_readiness)<>1,"Unavailable",IF([Analytics Ready]&&[Risk Ready]&&[Insights Ready],"Ready","Stale"))

Header =
"Price as of " & IF(ISBLANK(SELECTEDVALUE(reporting_readiness[price_as_of])),"unavailable",FORMAT(SELECTEDVALUE(reporting_readiness[price_as_of]),"yyyy-MM-dd")) & "  |  " & [Readiness] & "  |  Simulation completed " & IF(ISBLANK(SELECTEDVALUE(reporting_readiness[simulation_completed_at])),"unavailable",FORMAT(SELECTEDVALUE(reporting_readiness[simulation_completed_at]),"yyyy-MM-dd HH:mm"))

Simulation Run =
SELECTEDVALUE(reporting_readiness[simulation_run_id],"Unavailable")

Scenario Selector =
"Synthetic fixture scenario"

Fuel Cost USD =
IF(HASONEVALUE('Route Costs'[scenario_id]), SUM('Route Costs'[hedged_cost_usd]), BLANK())

Unhedged Cost USD =
CALCULATE(SUM('Route Costs'[unhedged_cost_usd]), REMOVEFILTERS('Route Costs'[scenario_id]),
    REMOVEFILTERS('Route Costs'[hedge_ratio]), REMOVEFILTERS('Hedge Scenario'), 'Route Costs'[hedge_ratio] = 0)

Fuel Gallons =
CALCULATE(SUM('Route Costs'[monthly_gallons]), REMOVEFILTERS('Route Costs'[scenario_id]),
    REMOVEFILTERS('Route Costs'[hedge_ratio]), REMOVEFILTERS('Hedge Scenario'), 'Route Costs'[hedge_ratio] = 0)

Mean Cost B =
SELECTEDVALUE('Risk Metrics'[mean_cost_b])

P95 Cost B =
SELECTEDVALUE('Risk Metrics'[p95_cost_b])

Incremental VaR95 B =
SELECTEDVALUE('Risk Metrics'[var_95_b])

CVaR95 B =
SELECTEDVALUE('Risk Metrics'[cvar_95_b])

VaR Reduction =
DIVIDE(SELECTEDVALUE('Risk Metrics'[var_reduction_pct]), 100)

Market Date =
CALCULATE(MAX(market_decomposition_current[price_date]),REMOVEFILTERS())

Latest Jet =
VAR d=[Market Date] RETURN CALCULATE(SELECTEDVALUE(market_decomposition_current[jet_fuel_gal]),REMOVEFILTERS(),market_decomposition_current[price_date]=d)

Prior Jet =
VAR d=[Market Date] VAR p=MAXX(FILTER(ALL(market_decomposition_current),market_decomposition_current[price_date]<=EDATE(d,-12)),market_decomposition_current[price_date]) RETURN CALCULATE(SELECTEDVALUE(market_decomposition_current[jet_fuel_gal]),REMOVEFILTERS(),market_decomposition_current[price_date]=p)

Change Jet =
IF([Insights Ready],[Latest Jet]-[Prior Jet])

Latest WTI =
VAR d=[Market Date] RETURN CALCULATE(SELECTEDVALUE(market_decomposition_current[wti_gal]),REMOVEFILTERS(),market_decomposition_current[price_date]=d)

Prior WTI =
VAR d=[Market Date] VAR p=MAXX(FILTER(ALL(market_decomposition_current),market_decomposition_current[price_date]<=EDATE(d,-12)),market_decomposition_current[price_date]) RETURN CALCULATE(SELECTEDVALUE(market_decomposition_current[wti_gal]),REMOVEFILTERS(),market_decomposition_current[price_date]=p)

Change WTI =
IF([Insights Ready],[Latest WTI]-[Prior WTI])

Latest HO =
VAR d=[Market Date] RETURN CALCULATE(SELECTEDVALUE(market_decomposition_current[heating_oil_gal]),REMOVEFILTERS(),market_decomposition_current[price_date]=d)

Prior HO =
VAR d=[Market Date] VAR p=MAXX(FILTER(ALL(market_decomposition_current),market_decomposition_current[price_date]<=EDATE(d,-12)),market_decomposition_current[price_date]) RETURN CALCULATE(SELECTEDVALUE(market_decomposition_current[heating_oil_gal]),REMOVEFILTERS(),market_decomposition_current[price_date]=p)

Change HO =
IF([Insights Ready],[Latest HO]-[Prior HO])

Latest Crack =
VAR d=[Market Date] RETURN CALCULATE(SELECTEDVALUE(market_decomposition_current[crack_spread]),REMOVEFILTERS(),market_decomposition_current[price_date]=d)

Prior Crack =
VAR d=[Market Date] VAR p=MAXX(FILTER(ALL(market_decomposition_current),market_decomposition_current[price_date]<=EDATE(d,-12)),market_decomposition_current[price_date]) RETURN CALCULATE(SELECTEDVALUE(market_decomposition_current[crack_spread]),REMOVEFILTERS(),market_decomposition_current[price_date]=p)

Change Crack =
IF([Insights Ready],[Latest Crack]-[Prior Crack])

WTI Monthly =
AVERAGE(market_decomposition_current[wti_gal])

Crack Monthly =
AVERAGE(market_decomposition_current[crack_spread])

Latest Monthly Jet =
VAR d=[Market Date] RETURN AVERAGEX(FILTER(ALL(market_decomposition_current),YEAR(market_decomposition_current[price_date])=YEAR(d)&&MONTH(market_decomposition_current[price_date])=MONTH(d)),market_decomposition_current[jet_fuel_gal])

Latest Month Annotation =
IF([Insights Ready],"Latest month $" & FORMAT([Latest Monthly Jet],"0.000") & "/gal")

Crack Historical Mean =
VAR y=YEAR([Market Date]) RETURN AVERAGEX(FILTER(ALL(market_decomposition_current),YEAR(market_decomposition_current[price_date])<y),market_decomposition_current[crack_spread])

Crack Share =
DIVIDE([Change Crack],[Change Jet])

WTI Offset =
DIVIDE([Change WTI],[Change Jet])

Crack Multiple =
DIVIDE([Latest Crack],[Crack Historical Mean])

Jet Rank =
VAR d=[Market Date] RETURN CALCULATE(SELECTEDVALUE(market_decomposition_current[jet_pct_rank_full_history]),REMOVEFILTERS(),market_decomposition_current[price_date]=d)

Waterfall Value =
IF([Insights Ready],SWITCH(SELECTEDVALUE('Market Steps'[Step]),"Start",[Prior Jet],"WTI change",[Change WTI],"Crack change",[Change Crack],"Latest",[Latest Jet]))

Bridge Low =
IF([Insights Ready],SWITCH(SELECTEDVALUE('Market Steps'[Step]),"Start",0,"Latest",0,"WTI change",MIN([Prior Jet],[Prior Jet]+[Change WTI]),"Crack change",MIN([Prior Jet]+[Change WTI],[Latest Jet])))

Bridge High =
IF([Insights Ready],SWITCH(SELECTEDVALUE('Market Steps'[Step]),"Start",[Prior Jet],"Latest",[Latest Jet],"WTI change",MAX([Prior Jet],[Prior Jet]+[Change WTI]),"Crack change",MAX([Prior Jet]+[Change WTI],[Latest Jet])))

Bridge Label =
IF([Insights Ready],IF(SELECTEDVALUE('Market Steps'[Step]) IN {"Start","Latest"},FORMAT([Waterfall Value],"$0.000"),FORMAT([Waterfall Value],"+$0.000;-$0.000;$0.000")))

Bridge Color =
SWITCH(SELECTEDVALUE('Market Steps'[Step]),"WTI change","#B85C38","Crack change","#E0A100","#1F4E79")

Change Per Gallon =
SWITCH(SELECTEDVALUE('Instruments'[Instrument]),"Jet",[Change Jet],"HO",[Change HO],"WTI",[Change WTI])

Price Level Correlation =
IF(MAX(proxy_return_correlation_current[price_date])>EDATE([Market Date],-36),SELECTEDVALUE(proxy_return_correlation_current[price_level_corr_jet_wti_90d]))

Latest Price Level Correlation =
VAR d=MAXX(ALL(proxy_return_correlation_current),proxy_return_correlation_current[price_date]) RETURN CALCULATE([Price Level Correlation],REMOVEFILTERS(),proxy_return_correlation_current[price_date]=d)

WTI Return Correlation =
IF(MAX(proxy_return_correlation_current[price_date])>EDATE([Market Date],-36),SELECTEDVALUE(proxy_return_correlation_current[ret_corr_jet_wti_90d]))

Latest WTI Return Correlation =
VAR d=MAXX(ALL(proxy_return_correlation_current),proxy_return_correlation_current[price_date]) RETURN CALCULATE([WTI Return Correlation],REMOVEFILTERS(),proxy_return_correlation_current[price_date]=d)

HO Return Correlation =
IF(MAX(proxy_return_correlation_current[price_date])>EDATE([Market Date],-36),SELECTEDVALUE(proxy_return_correlation_current[ret_corr_jet_ho_90d]))

Latest HO Return Correlation =
VAR d=MAXX(ALL(proxy_return_correlation_current),proxy_return_correlation_current[price_date]) RETURN CALCULATE([HO Return Correlation],REMOVEFILTERS(),proxy_return_correlation_current[price_date]=d)

Proxy R2 =
IF(SELECTEDVALUE(proxy_effectiveness_annual_current[year])<>"ALL",SELECTEDVALUE(proxy_effectiveness_annual_current[r2]))

Proxy Beta =
SELECTEDVALUE(proxy_effectiveness_annual_current[min_var_beta])

HO R2 =
CALCULATE([Proxy R2],proxy_effectiveness_annual_current[proxy]="HO")

HO Beta =
IF(SELECTEDVALUE(proxy_effectiveness_annual_current[year])<>"ALL",CALCULATE([Proxy Beta],proxy_effectiveness_annual_current[proxy]="HO"))

WTI R2 =
CALCULATE([Proxy R2],proxy_effectiveness_annual_current[proxy]="WTI")

WTI Beta =
IF(SELECTEDVALUE(proxy_effectiveness_annual_current[year])<>"ALL",CALCULATE([Proxy Beta],proxy_effectiveness_annual_current[proxy]="WTI"))

BRENT R2 =
CALCULATE([Proxy R2],proxy_effectiveness_annual_current[proxy]="BRENT")

BRENT Beta =
IF(SELECTEDVALUE(proxy_effectiveness_annual_current[year])<>"ALL",CALCULATE([Proxy Beta],proxy_effectiveness_annual_current[proxy]="BRENT"))

Years Compared =
COUNTROWS(FILTER(ALL(proxy_effectiveness_annual_current[year]),proxy_effectiveness_annual_current[year]<>"ALL"))

HO Wins Years =
VAR years=FILTER(ALL(proxy_effectiveness_annual_current[year]),proxy_effectiveness_annual_current[year]<>"ALL") RETURN IF([Insights Ready],COUNTROWS(FILTER(years,
        CALCULATE(SELECTEDVALUE(proxy_effectiveness_annual_current[r2]),proxy_effectiveness_annual_current[proxy]="HO")>CALCULATE(SELECTEDVALUE(proxy_effectiveness_annual_current[r2]),proxy_effectiveness_annual_current[proxy]="WTI")))+0)

WTI Years Effective =
IF([Insights Ready],COUNTROWS(FILTER(ALL(proxy_effectiveness_annual_current),proxy_effectiveness_annual_current[year]<>"ALL"&&proxy_effectiveness_annual_current[proxy]="WTI"&&proxy_effectiveness_annual_current[r2]>=0.8))+0)

Windows =
COUNTROWS(FILTER(ALL(hedge_backtest_windows_current),hedge_backtest_windows_current[hedge_ratio]=0))

Win Share =
DIVIDE(COUNTROWS(FILTER(FILTER(ALL(hedge_backtest_windows_current),hedge_backtest_windows_current[hedge_ratio]=0),hedge_backtest_windows_current[hedge_won]))+0,[Windows])

Mean Savings Gal =
AVERAGEX(FILTER(ALL(hedge_backtest_windows_current),hedge_backtest_windows_current[hedge_ratio]=0),hedge_backtest_windows_current[savings_per_gal])

Latest Window Rank =
CALCULATE(SELECTEDVALUE(hedge_backtest_windows_current[window_pct_rank]),REMOVEFILTERS(),hedge_backtest_windows_current[hedge_ratio]=0,hedge_backtest_windows_current[is_latest_complete]=TRUE())

Window Savings =
CALCULATE(SELECTEDVALUE(hedge_backtest_windows_current[savings_per_gal]),hedge_backtest_windows_current[hedge_ratio]=0)

Mean Overrun B =
IF(HASONEVALUE(hedge_backtest_windows_current[hedge_ratio]),AVERAGE(hedge_backtest_windows_current[budget_overrun_b]))

P95 Overrun B =
IF(HASONEVALUE(hedge_backtest_windows_current[hedge_ratio]),PERCENTILEX.INC(hedge_backtest_windows_current,hedge_backtest_windows_current[budget_overrun_b],0.95))

Historical Mean 0 =
CALCULATE([Mean Overrun B],REMOVEFILTERS(),hedge_backtest_windows_current[hedge_ratio]=0.0)

Historical P95 0 =
CALCULATE([P95 Overrun B],REMOVEFILTERS(),hedge_backtest_windows_current[hedge_ratio]=0.0)

Historical Mean 80 =
CALCULATE([Mean Overrun B],REMOVEFILTERS(),hedge_backtest_windows_current[hedge_ratio]=0.8)

Historical P95 80 =
CALCULATE([P95 Overrun B],REMOVEFILTERS(),hedge_backtest_windows_current[hedge_ratio]=0.8)

Historical Hedge Cost B =
IF([Insights Ready],[Historical Mean 80]-[Historical Mean 0])

Historical P95 Move =
PERCENTILEX.INC(FILTER(ALL(hedge_backtest_windows_current),hedge_backtest_windows_current[hedge_ratio]=0),DIVIDE(hedge_backtest_windows_current[realized_avg],hedge_backtest_windows_current[s0])-1,0.95)

Route Savings M =
IF(HASONEVALUE('Hedge Scenario'[scenario_id]),SUM('Route Costs'[hedge_savings_usd])/1000000)

Route Total Savings M =
CALCULATE([Route Savings M],REMOVEFILTERS(dim_route),REMOVEFILTERS(dim_month))

Route Count =
COUNTROWS(ALL(dim_route))

Selected Hedge Ratio =
SELECTEDVALUE('Hedge Scenario'[hedge_ratio])

Route Cost M =
DIVIDE([Fuel Cost USD],1000000)

Route Unhedged M =
DIVIDE([Unhedged Cost USD],1000000)

B767 Share =
DIVIDE(SUMX(FILTER(ALL(dim_route),dim_route[aircraft_type]="B767"),dim_route[avg_fuel_burn_gal]*dim_route[daily_frequencies]),SUMX(ALL(dim_route),dim_route[avg_fuel_burn_gal]*dim_route[daily_frequencies]))

B767 Departures =
SUMX(FILTER(ALL(dim_route),dim_route[aircraft_type]="B767"),dim_route[daily_frequencies])

Route Concentration Title =
"B767s use " & FORMAT([B767 Share],"0.0%") & " of scheduled gallons"

Route Concentration Subtitle =
"Synthetic fixture | Hedge savings by route, $M"

Current mu =
CALCULATE(SELECTEDVALUE(calibration_history_current[mu]),REMOVEFILTERS(),calibration_history_current[is_current]=TRUE())

Current sigma =
CALCULATE(SELECTEDVALUE(calibration_history_current[sigma]),REMOVEFILTERS(),calibration_history_current[is_current]=TRUE())

Current mu_pct_rank =
CALCULATE(SELECTEDVALUE(calibration_history_current[mu_pct_rank]),REMOVEFILTERS(),calibration_history_current[is_current]=TRUE())

Current sigma_pct_rank =
CALCULATE(SELECTEDVALUE(calibration_history_current[sigma_pct_rank]),REMOVEFILTERS(),calibration_history_current[is_current]=TRUE())

Calibration Count =
COUNTROWS(ALL(calibration_history_current))

Median Mu =
MEDIANX(ALL(calibration_history_current),calibration_history_current[mu])

MU =
SELECTEDVALUE(calibration_history_current[mu])

SIGMA =
SELECTEDVALUE(calibration_history_current[sigma])

Mu IQR Low =
PERCENTILEX.INC(ALL(calibration_history_current),calibration_history_current[mu],0.25)

Mu IQR High =
PERCENTILEX.INC(ALL(calibration_history_current),calibration_history_current[mu],0.75)

Band Coverage =
DIVIDE(COUNTROWS(FILTER(forecast_backtest_current,forecast_backtest_current[inside_band]))+0,COUNTROWS(forecast_backtest_current))

Below P05 =
DIVIDE(COUNTROWS(FILTER(forecast_backtest_current,forecast_backtest_current[below_p05]))+0,COUNTROWS(forecast_backtest_current))

High Drift Below P05 =
CALCULATE([Below P05],forecast_backtest_current[high_drift]=TRUE())

Log RMSE =
SQRT(AVERAGEX(forecast_backtest_current,forecast_backtest_current[log_err_p50]^2))

EWM Band Coverage =
CALCULATE([Band Coverage],REMOVEFILTERS(),forecast_backtest_current[drift_model]="EWM")

EWM High Drift Below P05 =
CALCULATE([High Drift Below P05],REMOVEFILTERS(),forecast_backtest_current[drift_model]="EWM")

Fan P05 =
SELECTEDVALUE(price_fan_current[p05_price_gal])

Fan P25 =
SELECTEDVALUE(price_fan_current[p25_price_gal])

Fan Median =
SELECTEDVALUE(price_fan_current[p50_price_gal])

Fan P75 =
SELECTEDVALUE(price_fan_current[p75_price_gal])

Fan P95 =
SELECTEDVALUE(price_fan_current[p95_price_gal])

Terminal Median =
VAR t=MAXX(ALL(price_fan_current),price_fan_current[step]) RETURN CALCULATE([Fan Median],REMOVEFILTERS(),price_fan_current[step]=t)

Mean Cost B 0 =
CALCULATE([Mean Cost B],REMOVEFILTERS(),'Risk Metrics'[hedge_ratio]=0.0)

Mean Cost B 80 =
CALCULATE([Mean Cost B],REMOVEFILTERS(),'Risk Metrics'[hedge_ratio]=0.8)

P95 Cost B 0 =
CALCULATE([P95 Cost B],REMOVEFILTERS(),'Risk Metrics'[hedge_ratio]=0.0)

P95 Cost B 80 =
CALCULATE([P95 Cost B],REMOVEFILTERS(),'Risk Metrics'[hedge_ratio]=0.8)

CVaR95 B 0 =
CALCULATE([CVaR95 B],REMOVEFILTERS(),'Risk Metrics'[hedge_ratio]=0.0)

CVaR95 B 80 =
CALCULATE([CVaR95 B],REMOVEFILTERS(),'Risk Metrics'[hedge_ratio]=0.8)

Spot Run Rate B =
[Latest Jet]*1.5

Simulation Hedge Cost B =
IF([Risk Ready],[Mean Cost B 80]-[Mean Cost B 0])

Mean Versus Run Rate =
IF([Risk Ready]&&[Insights Ready],DIVIDE([Mean Cost B 0],[Spot Run Rate B])-1)

Model History Cost =
IF([Readiness]="Ready",SWITCH(SELECTEDVALUE('Cost Basis'[Basis]),"Simulation",[Simulation Hedge Cost B],"History",[Historical Hedge Cost B]))

Histogram Paths =
IF(SELECTEDVALUE(cost_histogram_current[hedge_ratio]) IN {0,0.8},SUM(cost_histogram_current[path_count]))

Observed Tail =
SELECTEDVALUE(return_tail_frequency_current[observed_share])

Normal Tail =
SELECTEDVALUE(return_tail_frequency_current[normal_share])

Tail Ratio =
SELECTEDVALUE(return_tail_frequency_current[ratio])

Kurtosis =
SELECTEDVALUE(return_tail_frequency_current[excess_kurtosis])

Three Sigma Ratio =
CALCULATE([Tail Ratio],REMOVEFILTERS(),return_tail_frequency_current[threshold]=3)

Tail Kurtosis =
CALCULATE([Kurtosis],REMOVEFILTERS(),return_tail_frequency_current[threshold]=3)

Sensitivity Difference B =
IF(HASONEVALUE(v_hedge_sensitivity[hedge_ratio])&&HASONEVALUE(v_hedge_sensitivity[price_change_pct]),SELECTEDVALUE(v_hedge_sensitivity[hedged_cost_b])-SELECTEDVALUE(v_hedge_sensitivity[unhedged_cost_b]))

Break Even =
EXP(0.04)-1

Shock -30 Difference =
CALCULATE([Sensitivity Difference B],REMOVEFILTERS(),v_hedge_sensitivity[hedge_ratio]=0.8,v_hedge_sensitivity[price_change_pct]=-30)

Shock 50 Difference =
CALCULATE([Sensitivity Difference B],REMOVEFILTERS(),v_hedge_sensitivity[hedge_ratio]=0.8,v_hedge_sensitivity[price_change_pct]=50)

Nominal Coverage =
IF([Insights Ready],0.9)

Effective Benchmark =
IF([Insights Ready],0.8)

Historical P95 Price =
[Latest Jet]*(1+[Historical P95 Move])

Forward Price =
[Latest Jet]*EXP(0.04)

Readiness Color =
SWITCH([Readiness],"Ready","#2E8B57","Stale","#B85C38","#707070")

Sensitivity Magnitude =
VAR c=[Sensitivity Difference B] VAR cap=MAXX(ALL(v_hedge_sensitivity),ABS(v_hedge_sensitivity[hedged_cost_b]-v_hedge_sensitivity[unhedged_cost_b])) RETURN DIVIDE(ABS(c),cap)

Sensitivity Color =
VAR c=[Sensitivity Difference B] VAR s=[Sensitivity Magnitude] RETURN SWITCH(TRUE(),ISBLANK(c)||c=0,"#FFFFFF",c<0&&s>0.66,"#1F4E79",c<0&&s>0.33,"#82B5D5",c<0,"#D7E8F4",s>0.66,"#B85C38",s>0.33,"#E49C8D","#F3D9D3")

Sensitivity Font =
IF([Sensitivity Magnitude]>0.66,"#FFFFFF","#172B3A")

Ratio Color =
SWITCH(SELECTEDVALUE(hedge_backtest_windows_current[hedge_ratio]),0,"#DCEAF4",0.2,"#A6CCE3",0.4,"#6BAED6",0.6,"#3182BD",0.8,"#08519C","#707070")

Proxy Color =
SWITCH(SELECTEDVALUE(proxy_effectiveness_annual_current[proxy]),"HO","#2E8B57","WTI","#B85C38","BRENT","#7A6C9E","#707070")

Title 1.1 =
IF([Insights Ready], VAR c=[Change Crack] VAR w=[Change WTI] RETURN IF(ABS(c)>=ABS(w),"Crack spread","WTI-equivalent") & " contributed " & FORMAT(IF(ABS(c)>=ABS(w),[Crack Share],1-[Crack Share]),"0.0%") & " of jet’s " & FORMAT([Change Jet],"+$0.000;-$0.000;$0.000") & "/gal trailing-year change", "Unavailable — complete a current-source publication")

Title 1.2 =
IF([Insights Ready], "Jet moved from $" & FORMAT([Prior Jet],"0.000") & " to $" & FORMAT([Latest Jet],"0.000") & "/gal: crude plus crack reconcile exactly", "Unavailable — complete a current-source publication")

Title 2.1 =
IF([Insights Ready], "Price levels: WTI " & FORMAT([Latest Price Level Correlation],"0.00") & "; daily returns: WTI " & FORMAT([Latest WTI Return Correlation],"0.00") & ", heating oil " & FORMAT([Latest HO Return Correlation],"0.00"), "Unavailable — complete a current-source publication")

Title 2.2 =
IF([Insights Ready], IF([HO Wins Years]>[Years Compared]/2,"Heating oil","WTI") & " out-tracked " & IF([HO Wins Years]>[Years Compared]/2,"WTI","heating oil") & " in " & FORMAT(IF([HO Wins Years]>[Years Compared]/2,[HO Wins Years],[Years Compared]-[HO Wins Years]),"0") & " of " & FORMAT([Years Compared],"0") & " years; WTI cleared 0.80 R² in " & FORMAT([WTI Years Effective],"0"), "Unavailable — complete a current-source publication")

Title 2.3 =
IF([Insights Ready], "WTI changed " & FORMAT([Change WTI],"+$0.000;-$0.000;$0.000") & " vs jet " & FORMAT([Change Jet],"+$0.000;-$0.000;$0.000") & "/gal (" & FORMAT([WTI Offset],"0.0%") & "); heating oil " & FORMAT([Change HO],"+$0.000;-$0.000;$0.000"), "Unavailable — complete a current-source publication")

Title 3.1 =
IF([Insights Ready], "A one-year forward beat spot in " & FORMAT([Win Share],"0.0%") & " of " & FORMAT([Windows],"0") & " windows (mean " & FORMAT([Mean Savings Gal],"+$0.000;-$0.000;$0.000") & "/gal)", "Unavailable — complete a current-source publication")

Title 3.2 =
IF([Insights Ready], "80% cover moved historical P95 overrun from $" & FORMAT([Historical P95 0],"0.00") & "B to $" & FORMAT([Historical P95 80],"0.00") & "B; expected cost change " & FORMAT([Historical Hedge Cost B],"+$0.00;-$0.00;$0.00") & "B/yr", "Unavailable — complete a current-source publication")

Title 3.3 =
IF([Insights Ready]&&[Analytics Ready], "Synthetic " & FORMAT([Route Count],"0") & "-route schedule: " & IF(HASONEVALUE('Hedge Scenario'[scenario_id]),FORMAT(SELECTEDVALUE('Hedge Scenario'[hedge_ratio]),"0%") & " cover, " & FORMAT([Route Total Savings M],"+$0.00;-$0.00;$0.00") & "M savings","select one scenario") & "; " & FORMAT([B767 Share],"0.0%") & " of scheduled gallons on " & FORMAT([B767 Departures],"0") & " daily B767 departures", "Unavailable — complete a current-source publication")

Title 4.1 =
IF([Insights Ready]&&[Risk Ready], "Current drift " & FORMAT([Current mu],"0.0%") & "/yr ranks at " & FORMAT([Current mu_pct_rank],"0.0%") & " of " & FORMAT([Calibration Count],"0") & " calibrations; median " & FORMAT([Median Mu],"0.0%"), "Unavailable — complete a current-source publication")

Title 4.2 =
IF([Insights Ready]&&[Risk Ready], "EWM band covered " & FORMAT([EWM Band Coverage],"0.0%") & " of outcomes (nominal 90%); high-drift outcomes below P05: " & FORMAT([EWM High Drift Below P05],"0.0%"), "Unavailable — complete a current-source publication")

Title 4.3 =
IF([Insights Ready]&&[Risk Ready], "Model terminal median $" & FORMAT([Terminal Median],"0.000") & "/gal (" & FORMAT(DIVIDE([Terminal Median],[Latest Jet]),"0.0") & "× today); historical P95 average-price move " & FORMAT([Historical P95 Move],"+0.0%;-0.0%;0.0%"), "Unavailable — complete a current-source publication")

Title 4.4 =
IF([Insights Ready]&&[Risk Ready], "3-sigma weekly moves occur " & FORMAT([Three Sigma Ratio],"0.0") & "× the normal-implied rate; excess kurtosis " & FORMAT([Tail Kurtosis],"0.0"), "Unavailable — complete a current-source publication")

Title 5.1 =
IF([Insights Ready]&&[Risk Ready], "Unhedged mean $" & FORMAT([Mean Cost B 0],"0.00") & "B (" & FORMAT([Mean Versus Run Rate],"+0.0%;-0.0%;0.0%") & " vs $" & FORMAT([Spot Run Rate B],"0.00") & "B run-rate); CVaR95 $" & FORMAT([CVaR95 B 0],"0.00") & "B → $" & FORMAT([CVaR95 B 80],"0.00") & "B at 80%", "Unavailable — complete a current-source publication")

Title 5.2 =
IF([Insights Ready]&&[Risk Ready], "80% cover changes expected cost: model " & FORMAT([Simulation Hedge Cost B],"+$0.00;-$0.00;$0.00") & "B; history " & FORMAT([Historical Hedge Cost B],"+$0.00;-$0.00;$0.00") & "B. Interpret the drift–carry gap.", "Unavailable — complete a current-source publication")

Title 5.3 =
IF([Insights Ready]&&[Risk Ready], "Hedge break-even is " & FORMAT([Break Even],"0.0%") & "; 80% cover at −30%: " & FORMAT([Shock -30 Difference],"+$0.00;-$0.00;$0.00") & "B, at +50%: " & FORMAT([Shock 50 Difference],"+$0.00;-$0.00;$0.00") & "B", "Unavailable — complete a current-source publication")

Subtitle 1.1 =
"Actual EIA monthly averages; full history. Latest month may be partial."

Subtitle 1.2 =
"Crack $" & FORMAT([Latest Crack],"0.000") & "/gal = " & FORMAT([Crack Multiple],"0.0") & "× prior-years mean; jet full-sample rank " & FORMAT([Jet Rank],"0.0%")

Subtitle 2.1 =
"90 calendar days, ≥20 paired log returns. Price-level, misleading (dashed grey)."

Subtitle 2.2 =
"Weekly returns; missing weeks break returns. Benchmark 0.80; tooltip: minimum-variance beta."

Subtitle 2.3 =
"Actual spot changes. Position table: Synthetic fixture; linear spot proxies, not forward valuation."

Subtitle 3.1 =
"Latest complete window rank " & FORMAT([Latest Window Rank],"0.0%") & "; overlapping windows, descriptive evidence, no independent-trial claim."

Subtitle 3.2 =
"Reference carrier, 1.5B gal/yr | P95 of complete one-year purchase windows; means are arithmetic averages."

Subtitle 3.3 =
"Synthetic fixture | Latest complete historical window rank " & FORMAT([Latest Window Rank],"0.0%") & "; fixture calendar differs from weekly purchase windows."

Subtitle 4.1 =
"EWM μ and σ; full-sample μ interquartile band. Not a forecast."

Subtitle 4.2 =
"10,000 common paths/window/model; one-year purchase averages excluding S0. Log-RMSE in tooltip."

Subtitle 4.3 =
"Extrapolation of trailing-year drift, not a forecast | P05–P95 outer, P25–P75 inner band; median solid | Reference carrier, 1.5B gal/yr"

Subtitle 4.4 =
"Drift can overstate levels while normal shocks understate tail frequency; these errors do not cancel."

Subtitle 5.1 =
"Reference carrier, 1.5B gal/yr | Common-path GBM; not a forecast. Fixed 0% and 80% series."

Subtitle 5.2 =
"Reference carrier, 1.5B gal/yr | VaR reduction equals coverage (20/40/60/80%) by construction."

Subtitle 5.3 =
"Reference carrier, 1.5B gal/yr | Hedged minus unhedged cost; blue saving, red additional cost; signed labels."

