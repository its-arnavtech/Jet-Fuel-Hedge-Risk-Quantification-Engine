table 'dim_date'

	column 'calendar_date'
		dataType: dateTime
		summarizeBy: none
		sourceColumn: calendar_date
		formatString: yyyy-MM-dd

	column 'cost_month'
		dataType: dateTime
		summarizeBy: none
		sourceColumn: cost_month
		formatString: yyyy-MM-dd

	column 'year'
		dataType: int64
		summarizeBy: none
		sourceColumn: year

	column 'month'
		dataType: int64
		summarizeBy: none
		sourceColumn: month

	partition 'dim_date' = m
		mode: import
		source =
			GoldTable("dim_date")
