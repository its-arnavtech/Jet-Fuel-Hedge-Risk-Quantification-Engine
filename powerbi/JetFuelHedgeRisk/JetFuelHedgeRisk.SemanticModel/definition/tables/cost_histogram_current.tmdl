table 'cost_histogram_current'

	column 'hedge_ratio'
		dataType: double
		summarizeBy: none
		sourceColumn: hedge_ratio
		formatString: 0.0%

	column 'bin'
		dataType: int64
		summarizeBy: none
		sourceColumn: bin

	column 'bin_lower_cost_b'
		dataType: double
		summarizeBy: none
		sourceColumn: bin_lower_cost_b
		formatString: 0.00

	column 'bin_upper_cost_b'
		dataType: double
		summarizeBy: none
		sourceColumn: bin_upper_cost_b
		formatString: 0.00

	column 'path_count'
		dataType: int64
		summarizeBy: none
		sourceColumn: path_count

	partition 'cost_histogram_current' = m
		mode: import
		source =
			GoldTable("cost_histogram_current")
