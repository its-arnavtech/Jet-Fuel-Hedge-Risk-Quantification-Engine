table 'calibration_history_current'

	column 'week_ending'
		dataType: dateTime
		summarizeBy: none
		sourceColumn: week_ending
		formatString: yyyy-MM-dd

	column 'mu'
		dataType: double
		summarizeBy: none
		sourceColumn: mu
		formatString: 0.0%

	column 'sigma'
		dataType: double
		summarizeBy: none
		sourceColumn: sigma
		formatString: 0.0%

	column 'is_current'
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_current

	column 'mu_pct_rank'
		dataType: double
		summarizeBy: none
		sourceColumn: mu_pct_rank
		formatString: 0.0%

	column 'sigma_pct_rank'
		dataType: double
		summarizeBy: none
		sourceColumn: sigma_pct_rank
		formatString: 0.0%

	column 'insights_run_id'
		dataType: string
		summarizeBy: none
		sourceColumn: insights_run_id

	column 'source_pipeline_run_id'
		dataType: string
		summarizeBy: none
		sourceColumn: source_pipeline_run_id

	column 'created_ts'
		dataType: dateTime
		summarizeBy: none
		sourceColumn: created_ts
		formatString: yyyy-MM-dd

	column 'is_synthetic'
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_synthetic

	partition 'calibration_history_current' = m
		mode: import
		source =
			GoldTable("calibration_history_current")
