table 'proxy_effectiveness_annual_current'

	column 'year'
		dataType: string
		summarizeBy: none
		sourceColumn: year

	column 'proxy'
		dataType: string
		summarizeBy: none
		sourceColumn: proxy

	column 'n_weeks'
		dataType: int64
		summarizeBy: none
		sourceColumn: n_weeks

	column 'corr'
		dataType: double
		summarizeBy: none
		sourceColumn: corr
		formatString: 0.000

	column 'r2'
		dataType: double
		summarizeBy: none
		sourceColumn: r2
		formatString: 0.0%

	column 'min_var_beta'
		dataType: double
		summarizeBy: none
		sourceColumn: min_var_beta
		formatString: 0.000

	column 'meets_80pct_r2'
		dataType: boolean
		summarizeBy: none
		sourceColumn: meets_80pct_r2

	column 'insights_run_id'
		dataType: string
		summarizeBy: none
		sourceColumn: insights_run_id

	column 'source_pipeline_run_id'
		dataType: string
		summarizeBy: none
		sourceColumn: source_pipeline_run_id

	column 'created_ts'
		dataType: dateTime
		summarizeBy: none
		sourceColumn: created_ts
		formatString: yyyy-MM-dd

	column 'is_synthetic'
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_synthetic

	partition 'proxy_effectiveness_annual_current' = m
		mode: import
		source =
			GoldTable("proxy_effectiveness_annual_current")
