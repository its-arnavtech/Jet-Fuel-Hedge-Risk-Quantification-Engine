{
  "datasets": [
    {
      "name": "price_trend",
      "displayName": "EIA jet fuel price USD per gallon",
      "queryLines": [
        "SELECT price_date,jet_fuel_gal FROM workspace.jet_fuel_gold.v_price_correlation WHERE price_date>=date_add((SELECT max(price_date) FROM workspace.jet_fuel_gold.v_price_correlation),-365) ORDER BY price_date\n"
      ]
    },
    {
      "name": "route_cost",
      "displayName": "Unhedged cost by synthetic route USD",
      "queryLines": [
        "SELECT route_id,sum(monthly_fuel_cost_usd) AS fuel_cost_usd FROM workspace.jet_fuel_gold.v_route_burn GROUP BY route_id ORDER BY fuel_cost_usd DESC\n"
      ]
    },
    {
      "name": "hedge_marks",
      "displayName": "Synthetic hedge marks using matching underlying prices",
      "queryLines": [
        "SELECT position_id,underlying,current_spot_gal,unrealized_pnl_usd,hedge_status,as_of_date FROM workspace.jet_fuel_gold.v_hedge_mtm\n"
      ]
    },
    {
      "name": "risk_metrics",
      "displayName": "Reference carrier risk USD billions",
      "queryLines": [
        "SELECT hedge_ratio,mean_cost_b,p95_cost_b,var_95_b,cvar_95_b,var_reduction_pct FROM workspace.jet_fuel_gold.risk_metrics WHERE simulation_run_id=(SELECT simulation_run_id FROM workspace.jet_fuel_gold.latest_simulation_run)\n"
      ]
    },
    {
      "name": "price_fan",
      "displayName": "GBM price fan: 5 / 25 / 50 / 75 / 95 percentiles",
      "queryLines": [
        "SELECT time_years,p05_price_gal,p25_price_gal,p50_price_gal,p75_price_gal,p95_price_gal FROM workspace.jet_fuel_gold.price_fan WHERE simulation_run_id=(SELECT simulation_run_id FROM workspace.jet_fuel_gold.latest_simulation_run) ORDER BY step\n"
      ]
    },
    {
      "name": "cost_histogram",
      "displayName": "Unhedged cost histogram (latest successful run)",
      "queryLines": [
        "SELECT (bin_lower_cost_b+bin_upper_cost_b)/2 AS cost_b,path_count FROM workspace.jet_fuel_gold.cost_histogram WHERE simulation_run_id=(SELECT simulation_run_id FROM workspace.jet_fuel_gold.latest_simulation_run) AND hedge_ratio=0 ORDER BY bin\n"
      ]
    },
    {
      "name": "hedge_effectiveness",
      "displayName": "Incremental VaR reduction by hedge ratio",
      "queryLines": [
        "SELECT hedge_ratio,var_reduction_pct FROM workspace.jet_fuel_gold.risk_metrics WHERE simulation_run_id=(SELECT simulation_run_id FROM workspace.jet_fuel_gold.latest_simulation_run) ORDER BY hedge_ratio\n"
      ]
    },
    {
      "name": "sensitivity",
      "displayName": "Reference carrier cost under spot-price shocks",
      "queryLines": [
        "SELECT hedge_ratio,price_change_pct,hedged_cost_b FROM workspace.jet_fuel_gold.v_hedge_sensitivity ORDER BY hedge_ratio,price_change_pct\n"
      ]
    }
  ],
